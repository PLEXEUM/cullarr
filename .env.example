TZ=UTC
LOG_LEVEL=INFO
MAX_LOG_FILES=5
LOG_MAX_SIZE_MB=10

# Radarr client retry settings (optional)
# RADARR_RETRY_ATTEMPTS=3    # Number of retry attempts for Radarr API calls
# RADARR_RETRY_DELAY_BASE=2  # Base delay in seconds (exponential backoff: 2, 4, 8...)

# Scheduler timeout (seconds)
# RUN_TIMEOUT_SECONDS=7200   # Max runtime for score/cull jobs (default: 2 hours)